# Settings of the workshop stack. Compose reads this file and sources.env (the scripts pass both
# with --env-file) to fill in the ${VAR}s of compose.yaml.
#
# The secrets below are fixed and public ON PURPOSE: the stack only listens on 127.0.0.1, every
# participant runs their own copy, and the oXygen project file (oxygen/workshop.xpr) has the
# keys written into it. Never reuse them for a server.

# --- host ---------------------------------------------------------------------------------------
# The only published port (127.0.0.1 only). The oXygen project file assumes 1769; after a change
# run scripts/prepare.sh again (it rewrites workshop.xpr).
PORT=1769

# --- the workshop project -----------------------------------------------------------------------
# edition humboldt digital. Registered in webdav as app-led (is_index_app_source_of_truth):
# persons, places and institutions are kept and edited in the Index app; the texts are TEI in
# oXygen and reference the entries by their ids.
PROJECT=avhr
PROJECT_NAME=edition humboldt digital (Workshop)

# The one login (a webdav admin): platform, WebDAV in oXygen, admin apps.
WORKSHOP_USER_NAME=Workshop
WORKSHOP_USER_EMAIL=workshop@example.org
WORKSHOP_USER_PASSWORD=workshop

# --- fixed secrets (local only, see above) ------------------------------------------------------
WEBDAV_APP_KEY=base64:WOYUJuswN3GmGO/FldYluEyM5SlkWIRgBnlaBJBKXkc=
DB_ROOT_PASSWORD=workshop
DB_PASSWORD=workshop
# webdav's project registry; fileservice, id and index send it as Bearer
PLATFORM_SERVICE_TOKEN=ifgbfZxZsJgVysLcZVFBhvC0SxNAZ3YNQTYDoPIFECM
# oXygen → ediarum.index (register lookups) and ediarum.id (new ids)
INDEX_OXYGEN_KEY=9JbvLQryVxxX2zjKhA2sS2BDgU3JRU5RmAvhygaoJkI
ID_OXYGEN_KEY=UoGsSo5JrihjZW57AGMOaGl1mUnYSM4_l70226Do028
# webdav → fileservice (POST /files), and the id watcher → fileservice (status)
FILESERVICE_WEBDAV_KEY=Nm3AO8p6uI_zN5JuXUKWrYay0HLAYbSAUYisz_l3ouM
FILESERVICE_ADMIN_KEY=ErYZzP5GCRX24XJAyhXUIxSDWEShSCBk5hnQaOCdNK0
# ediarum.index → ediarum.id: the id of an entry created in the Index app
INDEX_ID_KEY=JvQ3ot-Bxu3louS8NfhzTARP4ycrXT8dXli7qZ4Xvfg

# --- timing -------------------------------------------------------------------------------------
# Seconds between the id watcher's checks: how long a saved text takes to reach ediarum.id.
RECONCILE_INTERVAL=30
