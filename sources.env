# Where the workshop gets its parts. Compose reads this file together with workshop.env (the
# start/stop/reset scripts pass both); scripts/prepare.sh reads the last three settings.
#
# Each value is either
#   - a path, relative to this folder: a local checkout, built as it is (uncommitted changes
#     included), or
#   - a git URL with #<tag, branch or commit>, plus :<subfolder> for an image built from a
#     sub-folder, e.g. https://github.com/ediarum/ediarum.index.git#v0.2.0:frontend
#     start.sh fetches it with your own git (and its login, as for git pull) into
#     .sources/<repo>/ and build from there.
#

# --- the services (Docker build contexts) -------------------------------------------------------
# PLATFORM_BUILD=../ediarum-platform
PLATFORM_BUILD=https://github.com/ediarum/ediarum.platform.git#v1.0.0
# WEBDAV_BUILD=../ediarum.webdav
WEBDAV_BUILD=https://github.com/ediarum/ediarum.WEBDAV.git#v1.0.0
# FILESERVICE_BUILD=../ediarum.fileservice
FILESERVICE_BUILD=https://github.com/ediarum/ediarum.fileservice.git#v0.1.2
# ID_BUILD=../ediarum.id
ID_BUILD=https://github.com/ediarum/ediarum.id.git#v0.1.2
# ID_FRONTEND_BUILD=../ediarum.id/frontend
ID_FRONTEND_BUILD=https://github.com/ediarum/ediarum.id.git#v0.1.2:frontend
# INDEX_BUILD=../ediarum.index
INDEX_BUILD=https://github.com/ediarum/ediarum.index.git#v0.2.0
# INDEX_FRONTEND_BUILD=../ediarum.index/frontend
INDEX_FRONTEND_BUILD=https://github.com/ediarum/ediarum.index.git#v0.2.0:frontend

# --- the generated folders, ready-made (start.sh) ------------------------------------------------
# The GitHub release's workshop-generated.tar.gz (dataset/ and oxygen/, built by GitHub Actions
# with prepare.sh). start.sh downloads and unpacks it when the folders are missing; empty:
# start.sh runs scripts/prepare.sh instead. scripts/release.sh sets it to the new tag's file.
GENERATED_URL=https://github.com/ediarum/ediarum.workshop/releases/download/v0.1.0/workshop-generated.tar.gz

# --- oXygen framework and data (scripts/prepare.sh) ----------------------------------------------
# A git URL is fetched into .sources/ (needs git); a path is used as it is.

# ediarum.BASE.edit: the framework for the letters (with its ediarum.jar)
BASE_EDIT_SOURCE=https://github.com/ediarum/ediarum.BASE.edit.git#v3.0.0

# The TEI dataset of edition humboldt digital (CC BY-SA 4.0), version 12
DATA_SOURCE=https://github.com/telota/edition-humboldt-digital.git#f128f89b9dc101254cd311b096f7569fbc1e001e
# The letters to include: a regular expression matched against each letter's <title>
DATA_LETTERS=Rugendas
